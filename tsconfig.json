  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "experimentalDecorators": true, "useDefineForClassFields": false,
    "strict": true, "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
